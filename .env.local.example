# Copy to .env.local and fill in from your Supabase project's
# Settings -> API page: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase renamed the legacy "anon key" to "publishable key" — use that one
# here (starts with sb_publishable_...), not the secret/service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Used to build the email-confirmation redirect link. Update for production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
